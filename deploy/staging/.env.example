# Vorlage für /opt/c9-website/deploy/staging/.env auf dem Server. Die echte Datei liegt NICHT
# im Git (siehe .gitignore) und wird verschlüsselt mitgesichert (c9-infra/scripts/backup-secrets.sh).
#
# Anlegen:  cp .env.example .env  und ausfüllen. Danach einmal von Hand deployen:
#   echo "$GHCR_TOKEN" | /opt/c9-website/deploy/deploy.sh deploy staging sha-<commit>

# Wird bei jedem Deploy von deploy.sh überschrieben. Beim ersten Mal den Tag eintragen,
# den der GitHub-Actions-Lauf anzeigt.
IMAGE_TAG=

# ZeptoMail-Token (Zoho, EU-Rechenzentrum). Darf derselbe Token wie in Produktion sein —
# entscheidend ist, dass C9_NOTIFY_EMAIL unten umgebogen wird. Ohne Token antwortet das
# Formular mit 502 und schreibt die Anfrage ins Container-Log, was zum Durchklicken reicht.
# ZEPTOMAIL_TOKEN=

# Absenderadresse. Muss auf einer in ZeptoMail verifizierten Domain liegen.
# Ohne Angabe: "CrimsonC9 <noreply@crimsonc9.com>".
# EMAIL_FROM=

# Empfänger der Formular-Benachrichtigungen. Hier bitte NICHT leer lassen: ein leerer Wert
# gilt als "nicht gesetzt", und dann geht die Post an hello@crimsonc9.com — genau das, was
# hier vermieden werden soll. Testanfragen zwischen echten Anfragen sind die Art Rauschen,
# die man irgendwann nicht mehr liest.
C9_NOTIFY_EMAIL=
