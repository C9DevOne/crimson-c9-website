# Vorlage für /opt/c9-website/deploy/staging/.env auf dem Server. Die echte Datei liegt NICHT
# im Git (siehe .gitignore) und wird verschlüsselt mitgesichert (c9-infra/scripts/backup-secrets.sh).
#
# Anlegen:  cp .env.example .env  und ausfüllen. Danach einmal von Hand deployen:
#   echo "$GHCR_TOKEN" | /opt/c9-website/deploy/deploy.sh deploy staging sha-<commit>

# Wird bei jedem Deploy von deploy.sh überschrieben. Beim ersten Mal den Tag eintragen,
# den der GitHub-Actions-Lauf anzeigt.
IMAGE_TAG=

# Resend-API-Key. Darf derselbe Key wie in Produktion sein — entscheidend ist, dass
# C9_NOTIFY_EMAIL unten umgebogen wird, sonst landen Testanfragen im echten Postfach.
# Ohne Key antwortet das Formular mit 502 und schreibt die Anfrage ins Container-Log,
# was zum Durchklicken reicht.
# RESEND_API_KEY=

# Absenderadresse. Muss auf einer in Resend verifizierten Domain liegen.
# Ohne Angabe: "CrimsonC9 <noreply@crimsonc9.com>".
# RESEND_FROM=

# Empfänger der Formular-Benachrichtigungen. Hier bitte NICHT auf hello@crimsonc9.com
# lassen: Staging ist zum Ausprobieren da, und Testanfragen zwischen echten Anfragen
# sind genau die Art Rauschen, die man irgendwann nicht mehr liest.
C9_NOTIFY_EMAIL=
