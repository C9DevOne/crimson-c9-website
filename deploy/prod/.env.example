# Vorlage für /opt/c9-website/deploy/prod/.env auf dem Server. Die echte Datei liegt NICHT
# im Git (siehe .gitignore) und wird verschlüsselt mitgesichert (c9-infra/scripts/backup-secrets.sh).
#
# Anlegen:  cp .env.example .env  und ausfüllen. Danach einmal von Hand deployen:
#   echo "$GHCR_TOKEN" | /opt/c9-website/deploy/deploy.sh deploy prod sha-<commit>

# Wird bei jedem Deploy von deploy.sh überschrieben. Beim ersten Mal den Tag eintragen,
# den der GitHub-Actions-Lauf anzeigt.
IMAGE_TAG=

# Resend-API-Key. OHNE diesen Key antwortet das Kontaktformular mit 502 und schreibt die
# Anfrage nur ins Container-Log — die Anfrage ist dann nicht verloren, aber auch nicht
# zugestellt. In Produktion also Pflicht.
RESEND_API_KEY=

# Absenderadresse. Muss auf einer in Resend verifizierten Domain liegen, sonst scheitert
# jeder Versand mit 403. Ohne Angabe: "CrimsonC9 <noreply@crimsonc9.com>".
# RESEND_FROM=

# Empfänger der Formular-Benachrichtigungen. Ohne Angabe: hello@crimsonc9.com.
# C9_NOTIFY_EMAIL=
