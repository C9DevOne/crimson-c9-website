# CrimsonC9 — environment variables
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Never commit .env.local — it's already in .gitignore, and it's the actual thing
# this file exists to keep out of git.
#
# Recommended way to get real values: `vercel link` once (links this folder to the
# team's Vercel project), then `vercel env pull .env.local` any time — pulls current
# values straight from Vercel instead of asking a teammate to paste them somewhere.


# ---------------------------------------------------------------------------
# Required — the app will not run without these, in dev or in production
# ---------------------------------------------------------------------------

# Postgres connection string. Shape: postgresql://user:password@host:port/database
# Real value from Supabase (Nick owns this) or `vercel env pull`. Contains a real
# password — treat it like any other credential, never paste it into chat.
DATABASE_URI=

# Signs admin login sessions (JWTs). Any long random string works — generate your
# own locally, nobody needs to hand you this one:
#   openssl rand -base64 32
# Must stay stable — changing it logs everyone out. Safe to reuse the same value
# across Preview/Production/local, unlike DATABASE_URI, since it isn't tied to a
# database or any external account.
PAYLOAD_SECRET=


# Backblaze B2 media storage (ADR-0004, docs/concepts/CONCEPT_media-pipeline.md).
# S3-compatible credentials for B2 bucket storage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ---------------------------------------------------------------------------
# Coming soon — not wired into the code yet, listed so the shape is known ahead
# of time. Don't set these until the corresponding feature actually lands; an
# unused env var sitting around with a stale value is its own small trap.
# ---------------------------------------------------------------------------

# Ticketing (ADR-0009) — platform not finalized (Pretix is the leading candidate),

# so the actual variables this needs aren't known yet. Whatever lands here will be
# added to this section when the platform is decided, not before.
