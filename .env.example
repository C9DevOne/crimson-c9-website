# CrimsonC9 — environment variables
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Never commit .env.local — it's already in .gitignore, and it's the actual thing
# this file exists to keep out of git.
#
# Recommended way to get real values: `vercel link` once (links this folder to the
# team's Vercel project), then `vercel env pull .env.local` any time — pulls current
# values straight from Vercel instead of asking a teammate to paste them somewhere.


# ---------------------------------------------------------------------------
# Required — the app will not run without these, in dev or in production
# ---------------------------------------------------------------------------

# Postgres connection string. Shape: postgresql://user:password@host:port/database
# Real value from Supabase (Nick owns this) or `vercel env pull`. Contains a real
# password — treat it like any other credential, never paste it into chat.
DATABASE_URI=

# Signs admin login sessions (JWTs). Any long random string works — generate your
# own locally, nobody needs to hand you this one:
#   openssl rand -base64 32
# Must stay stable — changing it logs everyone out. Safe to reuse the same value
# across Preview/Production/local, unlike DATABASE_URI, since it isn't tied to a
# database or any external account.
PAYLOAD_SECRET=


# ---------------------------------------------------------------------------
# Optional — the app has a working fallback if these are unset
# ---------------------------------------------------------------------------

# The canonical public URL of the deployed site — used for CORS, email links, and
# media URLs. Leave unset in local dev; payload.config.ts falls back to
# http://localhost:3000 automatically. Vercel sets this in the dashboard for
# Preview/Production (falls back further to its own auto-generated VERCEL_URL if
# that's ever missed).
# NEXT_PUBLIC_SERVER_URL=

# Resend API key — sends the notification email when somebody submits the landing
# page's collaboration form (src/lib/email.ts). Get it from resend.com.
#
# Unset is a supported state, not a broken one: the submission is still saved to the
# database and the server logs a warning instead of sending mail. So local dev needs
# nothing here — but Production without it means enquiries sit in the CMS unnoticed,
# which is the whole problem this was added to solve. Set it there.
# RESEND_API_KEY=

# Sender address for that email. Resend only accepts a `from` on a domain verified in
# the Resend account, so this has to match one — an unverified domain fails every send
# with a 403 that looks like a code bug. Defaults to
# "CrimsonC9 <noreply@crimsonc9.com>", which only works once crimsonc9.com is verified.
# RESEND_FROM=

# Where form notifications are delivered. Defaults to hello@crimsonc9.com. Worth
# overriding on Preview so test submissions don't land in the real inbox.
# C9_NOTIFY_EMAIL=


# ---------------------------------------------------------------------------
# Coming soon — not wired into the code yet, listed so the shape is known ahead
# of time. Don't set these until the corresponding feature actually lands; an
# unused env var sitting around with a stale value is its own small trap.
# ---------------------------------------------------------------------------

# Backblaze B2 media storage (ADR-0004, docs/concepts/CONCEPT_media-pipeline.md).
# Needed once @payloadcms/storage-s3 is actually installed and configured — right
# now Payload still writes uploads to the local filesystem, which doesn't survive
# a Vercel redeploy. Bucket-scoped application key, not the account master key.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Ticketing (ADR-0009) — platform not finalized (Pretix is the leading candidate),
# so the actual variables this needs aren't known yet. Whatever lands here will be
# added to this section when the platform is decided, not before.
